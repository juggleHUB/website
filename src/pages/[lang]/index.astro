---
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';
import FeatureCards from '../../components/FeatureCards.astro';
import Testimonials from '../../components/Testimonials.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('home', 'index');
const { hero_headline, hero_subtext, hero_cta_label, hero_cta_url, welcome_title, welcome_text, feature_cards, carousel_items, testimonials_title, testimonials_description, testimonials } = content.data[lang];

const t = {
  de: { about: 'Mehr über uns →' },
  en: { about: 'More about us →' },
}[lang];
---

<Layout title={lang === 'de' ? 'Startseite' : 'Home'} lang={lang} currentPath={`/${lang}/`} headerPad={false}>
  <!-- MOBILE hero -->
  <section class="navbreak:hidden bg-[#FFFDD7]">
    <!-- Text -->
    <div class="px-6 pt-28 pb-20">
      <h1 class="text-3xl font-black tracking-tight mb-4 leading-tight text-brand-dark">{hero_headline}</h1>
      <p class="text-base text-brand-dark/70 mb-7 leading-relaxed">{hero_subtext}</p>
      <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-base px-6 py-3 rounded-full hover:opacity-90 transition-colors shadow-md">
        {hero_cta_label}
      </a>
    </div>
    <!-- Image with woosh on top — image pulled up so woosh overlaps visible photo -->
    <div class="relative h-64 md:h-96 -mt-[62px]">
      <img
        src="https://picsum.photos/seed/hero-juggle/1600/700"
        alt="JuggleHUB workspace"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <img
        src="/woosh/hero-home-mob.svg"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-0 w-full z-10 pointer-events-none select-none"
      />
    </div>
  </section>

  <!-- DESKTOP hero -->
  <section class="hidden navbreak:block relative overflow-hidden max-h-[760px]">
    <!-- Invisible height sizer -->
    <img src="/woosh/hero-home.svg" aria-hidden="true" class="w-full opacity-0 pointer-events-none select-none" />
    <!-- Photo — full background -->
    <img
      src="https://picsum.photos/seed/hero-juggle/1600/700"
      alt="JuggleHUB workspace"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- Solid left panel -->
    <div class="absolute inset-y-0 left-0 w-[40%] bg-[#FFFDD7]"></div>
    <!-- Woosh SVG — starts at 40%, full height -->
    <img
      src="/woosh/hero-home.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-0 left-[40%] h-full w-auto pointer-events-none select-none"
    />
    <!-- Text — sits on the solid left panel -->
    <div class="absolute inset-0 z-10 flex items-center">
      <div class="w-[40%] flex justify-end pr-10 lg:pr-16">
      <div class="w-full max-w-sm pt-16">
        <h1 class="text-5xl lg:text-6xl font-black tracking-tight mb-6 leading-tight text-brand-dark">{hero_headline}</h1>
        <p class="text-lg lg:text-xl text-brand-dark/70 mb-10 leading-relaxed">{hero_subtext}</p>
        <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-lg px-8 py-4 rounded-full hover:opacity-90 transition-colors shadow-lg">
          {hero_cta_label}
        </a>
      </div>
      </div>
    </div>
  </section>

  <div class="relative overflow-hidden">
    <img
      src="/woosh/yellow-baby-heart-vertical.svg"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full pointer-events-none select-none"
      style="object-fit: cover; opacity: 0.5;"
    />

  <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
    <h2 class="text-4xl font-black mb-6">{welcome_title}</h2>
    <p class="text-lg text-gray-600 leading-relaxed">{welcome_text}</p>
    <a href={`/${lang}/about/`} class="inline-flex items-center mt-6 text-brand-dark font-semibold underline underline-offset-4 hover:text-gray-600 transition-colors">{t.about}</a>
  </section>

  <Carousel items={carousel_items} />

  <FeatureCards cards={feature_cards} desktopCols={5} paddingTop="pt-0" />
  </div>

  <Testimonials
    title={testimonials_title}
    description={testimonials_description}
    testimonials={testimonials}
  />

  <ContactForm lang={lang} />
</Layout>
