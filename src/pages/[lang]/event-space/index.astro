---
import Layout from '../../../layouts/Layout.astro';
import RoomCarousel from '../../../components/RoomCarousel.astro';
import Pricing from '../../../components/Pricing.astro';
import Testimonials from '../../../components/Testimonials.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('eventspace', 'index');
const { headline, intro, hero_cta_label, hero_cta_url, welcome_title, welcome_text, rooms, pricing } = content.data[lang];

const [heroIntro, ...introRestParts] = intro.split('\n\n');
const introRest = introRestParts.join('\n\n');
---

<Layout title={headline} description={intro} lang={lang} currentPath={`/${lang}/event-space/`} headerPad={false}>
  <div class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none select-none"
      style="background-image: url('/woosh/yellow-baby-heart-vertical.svg'); background-repeat: repeat-y; background-position: center top; background-size: min(100%, 640px) auto; opacity: 0.5;"
    ></div>
    <div class="relative">
  <!-- MOBILE hero -->
  <section class="navbreak:hidden bg-[#FFFDD7]">
    <div class="px-6 pt-28 pb-20">
      <div class="w-16 h-16 rounded-xl overflow-hidden mb-5">
        <img src="/images/icons/room.png" alt="" width="64" height="64" loading="eager" decoding="async" class="w-full h-full object-cover" />
      </div>
      <h1 class="text-3xl font-black tracking-tight mb-4 leading-tight text-brand-dark">{headline}</h1>
      <p class="text-base text-brand-dark/70 mb-7 leading-relaxed">{heroIntro}</p>
      {hero_cta_label && hero_cta_url && (
        <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-base px-6 py-3 rounded-full hover:opacity-90 transition-colors shadow-md">
          {hero_cta_label}
        </a>
      )}
    </div>
    <div class="relative h-64 md:h-96 -mt-[62px]">
      <img
        src="/images/pages/event-space/event-hero.jpg"
        alt="JuggleHUB event space"
        width="1600"
        height="700"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <img
        src="/woosh/hero-home-mob.svg"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-0 w-full z-10 pointer-events-none select-none"
      />
    </div>
  </section>

  <!-- DESKTOP hero -->
  <section class="hidden navbreak:block relative overflow-hidden max-h-[760px]">
    <img src="/woosh/hero-home.svg" aria-hidden="true" class="w-full opacity-0 pointer-events-none select-none" />
    <img
      src="/images/pages/event-space/event-hero.jpg"
      alt="JuggleHUB event space"
      width="1600"
      height="700"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-y-0 left-0 w-[40%] bg-[#FFFDD7]"></div>
    <img
      src="/woosh/hero-event-space.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-0 left-[40%] h-full w-auto pointer-events-none select-none"
    />
    <div class="absolute inset-0 z-10 flex items-center">
      <div class="w-[40%] flex justify-end pr-10 lg:pr-16">
        <div class="w-full max-w-sm pt-16">
          <div class="w-20 h-20 rounded-xl overflow-hidden mb-6">
            <img src="/images/icons/room.png" alt="" width="80" height="80" loading="eager" decoding="async" class="w-full h-full object-cover" />
          </div>
          <h1 class="text-5xl lg:text-6xl font-black tracking-tight mb-6 leading-tight text-brand-dark">{headline}</h1>
          <p class="text-lg lg:text-xl text-brand-dark/70 mb-10 leading-relaxed">{heroIntro}</p>
          {hero_cta_label && hero_cta_url && (
            <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-lg px-8 py-4 rounded-full hover:opacity-90 transition-colors shadow-lg">
              {hero_cta_label}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

    {introRest && (
      <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 pt-16">
        <p class="text-lg text-gray-600 leading-relaxed whitespace-pre-line">{introRest}</p>
      </section>
    )}

    {(welcome_title || welcome_text) && (
      <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 pt-8 pb-8">
        {welcome_title && <h2 class="text-4xl font-black mb-6">{welcome_title}</h2>}
        {welcome_text && <p class="text-lg text-gray-600 leading-relaxed">{welcome_text}</p>}
      </section>
    )}

    {rooms && rooms.length > 0 && <RoomCarousel rooms={rooms} />}
  {pricing && (
    <div class="pt-8">
      <Pricing
        title={pricing.title}
        notes={pricing.notes}
        cards={pricing.cards}
        headerColor="#F0E68C"
        accentColor="#C8A800"
        desktopCols={4}
      />
    </div>
  )}

  <Testimonials
    title={lang === 'de' ? 'Was unsere Gäste sagen' : 'What our guests say'}
    description={lang === 'de' ? 'Stimmen von Menschen, die bei uns veranstaltet haben.' : 'Voices from people who have hosted events with us.'}
    testimonials={lang === 'de' ? [
      { text: 'Der Konferenzraum war perfekt für unser Teamklausur. Alles war bereit, als wir ankamen – Technik, Kaffee, alles. Wir kommen definitiv wieder.', name: 'Mara K., Teamleiterin' },
      { text: 'Wir haben unseren Produktlaunch hier veranstaltet und waren begeistert. Die Atmosphäre war professionell und einladend zugleich. Absolute Empfehlung.', name: 'Jonas W., Gründer' },
      { text: 'Endlich ein Event Space, der sich nicht wie eine leere Lagerhalle anfühlt. Helles, freundliches Ambiente und ein super hilfsbereites Team.', name: 'Lena S., Community Managerin' },
    ] : [
      { text: 'The conference room was perfect for our team retreat. Everything was set up and ready when we arrived — tech, coffee, all of it. We\'ll definitely be back.', name: 'Mara K., Team Lead' },
      { text: 'We hosted our product launch here and were blown away. The atmosphere felt professional and welcoming at the same time. Highly recommended.', name: 'Jonas W., Founder' },
      { text: 'Finally an event space that doesn\'t feel like an empty warehouse. Bright, friendly atmosphere and an incredibly helpful team.', name: 'Lena S., Community Manager' },
    ]}
  />

  <section class="py-20">
    <div class="max-w-3xl mx-auto px-8 sm:px-14 lg:px-20">
      <h2 class="text-4xl font-black mb-10">{lang === 'de' ? 'Schreib uns' : 'Get in touch'}</h2>

      <form class="flex flex-col gap-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-brand-dark">{lang === 'de' ? 'Name' : 'Name'}</label>
            <input
              type="text"
              name="name"
              class="rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-teal/40 focus:border-brand-teal transition"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-brand-dark">{lang === 'de' ? 'E-Mail' : 'Email'}</label>
            <input
              type="email"
              name="email"
              class="rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-teal/40 focus:border-brand-teal transition"
            />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-brand-dark">{lang === 'de' ? 'Betreff' : 'Subject'}</label>
          <input
            type="text"
            name="subject"
            class="rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-teal/40 focus:border-brand-teal transition"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-brand-dark">{lang === 'de' ? 'Nachricht' : 'Message'}</label>
          <textarea
            name="message"
            rows="5"
            class="rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-teal/40 focus:border-brand-teal transition resize-none"
          ></textarea>
        </div>

        <div>
          <button
            type="submit"
            class="bg-brand-teal text-white font-bold px-8 py-3 rounded-full hover:opacity-90 transition-opacity"
          >
            {lang === 'de' ? 'Nachricht senden' : 'Send message'}
          </button>
        </div>
      </form>
    </div>
  </section>
    </div>
  </div>
</Layout>
