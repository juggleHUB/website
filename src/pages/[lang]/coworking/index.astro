---
import Layout from '../../../layouts/Layout.astro';
import FeatureCards from '../../../components/FeatureCards.astro';
import Pricing from '../../../components/Pricing.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('coworking', 'index');
const { headline, hero_image, icon_image, community_image, intro, hero_cta_label, hero_cta_url, welcome_title, welcome_text, cards, pricing } = content.data[lang];

const [heroIntro, ...introRestParts] = intro.split('\n\n');
const introRest = introRestParts.join('\n\n');
---

<Layout title={headline} description={intro} lang={lang} currentPath={`/${lang}/coworking/`} headerPad={false}>
  <div class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute inset-0 pointer-events-none select-none"
      style="background-image: url('/woosh/blue-baby-heart-vertical.svg'); background-repeat: repeat-y; background-position: center top; background-size: min(100%, 640px) auto; opacity: 0.5;"
    ></div>
    <div class="relative">
  <!-- MOBILE hero -->
  <section class="navbreak:hidden bg-[#E6F5F3]">
    <div class="px-6 pt-28 pb-20">
      <div class="w-16 h-16 mb-5 rounded-xl overflow-hidden">
        <img src={icon_image} alt="" width="64" height="64" loading="eager" decoding="async" class="w-full h-full object-cover" />
      </div>
      <h1 class="text-3xl font-black tracking-tight mb-4 leading-tight text-brand-dark">{headline}</h1>
      <p class="text-base text-brand-dark/70 mb-7 leading-relaxed">{heroIntro}</p>
      {hero_cta_label && hero_cta_url && (
        <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-base px-6 py-3 rounded-full hover:opacity-90 transition-colors shadow-md">
          {hero_cta_label}
        </a>
      )}
    </div>
    <div class="relative h-64 md:h-96 -mt-[62px]">
      <img
        src={hero_image}
        alt="JuggleHUB coworking space"
        width="940"
        height="1085"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <img
        src="/woosh/hero-coworking-gentle-mob.svg"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-0 w-full z-10 pointer-events-none select-none"
      />
    </div>
  </section>

  <!-- DESKTOP hero -->
  <section class="hidden navbreak:block relative overflow-hidden max-h-[760px]">
    <img src="/woosh/hero-coworking.svg" aria-hidden="true" class="w-full opacity-0 pointer-events-none select-none" />
    <img
      src={hero_image}
      alt="JuggleHUB coworking space"
      width="940"
      height="1085"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-y-0 left-0 w-[40%] bg-[#E6F5F3]"></div>
    <img
      src="/woosh/hero-coworking-gentle.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-0 left-[40%] h-full w-auto pointer-events-none select-none"
    />
    <div class="absolute inset-0 z-10 flex items-center">
      <div class="w-[40%] flex justify-end pr-10 lg:pr-16">
        <div class="w-full max-w-sm pt-20 pb-10">
          <div class="w-20 h-20 mb-6 rounded-xl overflow-hidden">
            <img src={icon_image} alt="" width="80" height="80" loading="eager" decoding="async" class="w-full h-full object-cover" />
          </div>
          <h1 class="text-4xl lg:text-5xl font-black tracking-tight mb-6 leading-tight text-brand-dark">{headline}</h1>
          <p class="text-lg lg:text-xl text-brand-dark/70 mb-10 leading-relaxed">{heroIntro}</p>
          {hero_cta_label && hero_cta_url && (
            <a href={hero_cta_url} class="inline-flex items-center bg-brand-teal text-white font-bold text-lg px-8 py-4 rounded-full hover:opacity-90 transition-colors shadow-lg">
              {hero_cta_label}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

    {introRest && (
      <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 pt-16">
        <p class="text-lg text-gray-600 leading-relaxed whitespace-pre-line">{introRest}</p>
      </section>
    )}

    <figure class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 pt-12">
      <img
        src={community_image}
        alt={lang === 'de' ? 'Gemeinsames Mittagessen im juggleHUB' : 'Community lunch at juggleHUB'}
        width="2000"
        height="1125"
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded-2xl"
      />
    </figure>

    {(welcome_title || welcome_text) && (
      <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 pt-20 pb-8">
        {welcome_title && <h2 class="text-4xl font-black mb-6">{welcome_title}</h2>}
        {welcome_text && <p class="text-lg text-gray-600 leading-relaxed">{welcome_text}</p>}
      </section>
    )}

    {cards && cards.length > 0 && <FeatureCards cards={cards} desktopCols={4} showIcon={false} paddingTop="pt-0" />}

    {pricing && <Pricing title={pricing.title} description={pricing.description} notes={pricing.notes} cards={pricing.cards} />}

    </div>
  </div>

</Layout>
