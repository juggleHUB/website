---
import Layout from '../../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('press', 'index');
const { headline, press_releases } = content.data[lang];
const description = lang === 'de'
  ? 'Pressemitteilungen und Medienberichte über JuggleHUB – Berlins Coworking-Space mit integrierter Kinderbetreuung.'
  : 'Press releases and media coverage about JuggleHUB – Berlin\'s coworking space with integrated childcare.';
---

<Layout title={headline} description={description} lang={lang} currentPath={`/${lang}/about/press/`}>
  <div class="max-w-3xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
    <h1 class="text-4xl lg:text-5xl font-black mb-12">{headline}</h1>
    <div class="space-y-4">
      {press_releases.map((pr: { date?: string; title: string; button_text?: string; url?: string }) => (
        <div class="bg-white rounded-2xl border border-gray-100 p-6 flex flex-col navbreak:flex-row navbreak:items-center navbreak:justify-between gap-3">
          <div>
            {pr.date && <p class="text-sm text-gray-400 mb-1">{pr.date}</p>}
            <p class="font-semibold text-lg">{pr.title}</p>
          </div>
          {pr.url && (
            <a href={pr.url} target="_blank" rel="noopener noreferrer" class="self-start navbreak:self-center shrink-0 bg-brand-yellow text-brand-dark text-sm font-bold px-4 py-2 rounded-lg hover:bg-yellow-300 transition-colors">
              {pr.button_text || (lang === 'de' ? 'Mehr lesen' : 'Read more')}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
