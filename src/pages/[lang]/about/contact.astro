---
import Layout from '../../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('contact', 'index');
const { headline, location_title, name, address, tram, hours, hours_note, email_general, email_childcare, email_space, phone } = content.data[lang];
const description = lang === 'de'
  ? 'Kontaktiere JuggleHUB – wir sind für dich da. Adresse, Öffnungszeiten, E-Mail und Telefon auf einen Blick.'
  : 'Get in touch with JuggleHUB – we are here for you. Address, opening hours, email and phone at a glance.';
---

<Layout title={headline} description={description} lang={lang} currentPath={`/${lang}/about/contact/`}>
  <div class="max-w-3xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
    <h1 class="text-4xl lg:text-5xl font-black mb-12">{headline}</h1>
    <div class="bg-white rounded-2xl border border-gray-100 p-8 space-y-8">

      <!-- Location -->
      <div>
        <h2 class="font-bold text-sm uppercase tracking-widest text-gray-400 mb-3">{location_title}</h2>
        <p class="text-lg font-bold">{name}</p>
        <p class="mt-1">{address}</p>
        <p class="text-gray-500 text-sm mt-1">{lang === 'de' ? 'Tramstation:' : 'Tram stop:'} {tram}</p>
        <p class="mt-3 font-medium">{hours}</p>
        <p class="text-gray-500 text-sm mt-1">{hours_note}</p>
      </div>

      <hr class="border-gray-100" />

      <!-- Email -->
      <div>
        <h2 class="font-bold text-sm uppercase tracking-widest text-gray-400 mb-3">E-Mail</h2>
        <div class="space-y-2">
          <div>
            <span class="text-gray-500 text-sm">{lang === 'de' ? 'Allgemeine Anfragen' : 'General enquiries'}</span>
            <p><a href={`mailto:${email_general}`} class="text-brand-dark hover:text-gray-600">{email_general}</a></p>
          </div>
          <div>
            <span class="text-gray-500 text-sm">{lang === 'de' ? 'Kinderbetreuung' : 'Childcare'}</span>
            <p><a href={`mailto:${email_childcare}`} class="text-brand-dark hover:text-gray-600">{email_childcare}</a></p>
          </div>
          <div>
            <span class="text-gray-500 text-sm">{lang === 'de' ? 'Raumbuchungen' : 'Room bookings'}</span>
            <p><a href={`mailto:${email_space}`} class="text-brand-dark hover:text-gray-600">{email_space}</a></p>
          </div>
        </div>
      </div>

      <hr class="border-gray-100" />

      <!-- Phone -->
      <div>
        <h2 class="font-bold text-sm uppercase tracking-widest text-gray-400 mb-3">{lang === 'de' ? 'Telefon' : 'Phone'}</h2>
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="text-lg text-brand-dark hover:text-gray-600">{phone}</a>
      </div>

    </div>
  </div>
</Layout>
