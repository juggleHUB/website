---
import Layout from '../../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('faq', 'index');
const { headline, categories } = content.data[lang];
const description = lang === 'de'
  ? 'Häufig gestellte Fragen zu Coworking, Kinderbetreuung, Meetingräumen, Team Offices und Virtual Office bei juggleHUB Berlin.'
  : 'Frequently asked questions about coworking, childcare, meeting rooms, team offices and virtual office at juggleHUB Berlin.';
---

<Layout title={headline} description={description} lang={lang} currentPath={`/${lang}/about/faq/`}>
  <div class="max-w-3xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
    <h1 class="text-4xl lg:text-5xl font-black mb-12">{headline}</h1>
    <div class="space-y-12">
      {categories.map((category: { icon?: string; title: string; items: { question: string; answer: string }[] }) => (
        <div>
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
            {category.icon && <span aria-hidden="true">{category.icon}</span>}
            {category.title}
          </h2>
          <div class="space-y-4">
            {category.items.map((item) => (
              <details class="bg-white rounded-2xl border border-gray-100 overflow-hidden group">
                <summary class="flex items-center justify-between px-6 py-5 cursor-pointer font-semibold text-lg list-none">
                  {item.question}
                  <span class="text-brand-teal text-2xl font-black group-open:rotate-45 transition-transform">+</span>
                </summary>
                <div class="px-6 pb-5 text-gray-600 leading-relaxed">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
