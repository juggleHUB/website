---
import Layout from '../../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('ourstory', 'index');
const { headline, body } = content.data[lang];
const htmlBody = marked(body);
const description = lang === 'de'
  ? 'Zehn Jahre juggleHUB: Erfahre, wie Katja und Silvia 2016 den ersten familienfreundlichen Coworking Space in Berlin eröffneten.'
  : 'Ten years of juggleHUB: find out how Katja and Silvia opened Berlin\'s first family-friendly coworking space in 2016.';
---

<Layout title={headline} description={description} lang={lang} currentPath={`/${lang}/about/our-story/`}>
  <div class="max-w-3xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
    <h1 class="text-4xl lg:text-5xl font-black mb-10">{headline}</h1>
    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-brand-dark bg-white rounded-2xl p-8 border border-gray-100" set:html={htmlBody} />
  </div>
</Layout>
