---
import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';
import Pricing from '../../../components/Pricing.astro';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: 'de' | 'en' };
const content = await getEntry('childcare', 'index');
const { headline, intro, hero_cta_label, hero_cta_url, welcome_title, welcome_text, carousel_items, pricing } = content.data[lang];
---

<Layout title={headline} description={intro} lang={lang} currentPath={`/${lang}/flexible-childcare/`} headerPad={false}>
  <!-- MOBILE hero -->
  <section class="navbreak:hidden bg-[#FFE9E1]">
    <div class="px-6 pt-28 pb-20">
      <div class="w-16 h-16 rounded-xl bg-gray-200 mb-5"></div>
      <h1 class="text-3xl font-black tracking-tight mb-4 leading-tight text-brand-dark">{headline}</h1>
      <p class="text-base text-brand-dark/70 mb-7 leading-relaxed">{intro}</p>
      {hero_cta_label && hero_cta_url && (
        <a href={hero_cta_url} class="inline-flex items-center bg-brand-coral text-white font-bold text-base px-6 py-3 rounded-full hover:opacity-90 transition-colors shadow-md">
          {hero_cta_label}
        </a>
      )}
    </div>
    <div class="relative h-64 md:h-96 -mt-[62px]">
      <img
        src="https://picsum.photos/seed/childcare-hero/1600/700"
        alt="JuggleHUB childcare"
        width="1600"
        height="700"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <img
        src="/woosh/hero-childcare-mob.svg"
        alt=""
        aria-hidden="true"
        class="absolute top-0 left-0 w-full z-10 pointer-events-none select-none"
      />
    </div>
  </section>

  <!-- DESKTOP hero -->
  <section class="hidden navbreak:block relative overflow-hidden max-h-[760px]">
    <img src="/woosh/hero-childcare.svg" aria-hidden="true" class="w-full opacity-0 pointer-events-none select-none" />
    <img
      src="https://picsum.photos/seed/childcare-hero/1600/700"
      alt="JuggleHUB childcare"
      width="1600"
      height="700"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-y-0 left-0 w-[40%] bg-[#FFE9E1]"></div>
    <img
      src="/woosh/hero-childcare.svg"
      alt=""
      aria-hidden="true"
      class="absolute top-0 left-[40%] h-full w-auto pointer-events-none select-none"
    />
    <div class="absolute inset-0 z-10 flex items-center">
      <div class="w-[40%] flex justify-end pr-10 lg:pr-16">
        <div class="w-full max-w-sm pt-16">
          <div class="w-20 h-20 rounded-xl bg-gray-200 mb-6"></div>
          <h1 class="text-5xl lg:text-6xl font-black tracking-tight mb-6 leading-tight text-brand-dark">{headline}</h1>
          <p class="text-lg lg:text-xl text-brand-dark/70 mb-10 leading-relaxed">{intro}</p>
          {hero_cta_label && hero_cta_url && (
            <a href={hero_cta_url} class="inline-flex items-center bg-brand-coral text-white font-bold text-lg px-8 py-4 rounded-full hover:opacity-90 transition-colors shadow-lg">
              {hero_cta_label}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="relative overflow-hidden">
    <img
      src="/woosh/coral-baby-heart-vertical.svg"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full pointer-events-none select-none -z-10"
      style="object-fit: cover; opacity: 0.5;"
    />

    {(welcome_title || welcome_text) && (
      <section class="relative max-w-4xl mx-auto px-8 sm:px-14 lg:px-20 py-20">
        {welcome_title && <h2 class="text-4xl font-black mb-6">{welcome_title}</h2>}
        {welcome_text && <p class="text-lg text-gray-600 leading-relaxed">{welcome_text}</p>}
      </section>
    )}

    {carousel_items && carousel_items.length > 0 && (
      <Carousel items={carousel_items} />
    )}

    {pricing && (
      <Pricing
        title={pricing.title}
        notes={pricing.notes}
        cards={pricing.cards}
        headerColor="#FFE9E1"
        accentColor="#E05B4B"
        lastSpan={true}
      />
    )}
  </div>
</Layout>
