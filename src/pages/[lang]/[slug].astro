---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  const slugs = entries.map(e => e.id.replace(/\.json$/, ''));
  return ['de', 'en'].flatMap(lang =>
    slugs.map(slug => ({ params: { lang, slug } }))
  );
}

const { lang, slug } = Astro.params as { lang: 'de' | 'en'; slug: string };
const entry = await getEntry('pages', slug);
if (!entry) return Astro.redirect('/404');

const { title, body } = entry.data[lang];
const htmlBody = marked(body);
---

<Layout title={title} lang={lang} currentPath={`/${lang}/${slug}/`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <h1 class="text-4xl lg:text-5xl font-black mb-10">{title}</h1>
    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-brand-dark bg-white rounded-2xl p-8 border border-gray-100" set:html={htmlBody} />
  </div>
</Layout>
