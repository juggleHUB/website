---
export interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const base = `/${lang}`;
const year = new Date().getFullYear();

const t = {
  de: {
    location_name: 'juggleHUB Coworking & The Daily Café',
    address: 'Immanuelkirchstr. 14a, 10405 Berlin',
    tram: 'Tramstation Hufelandstraße',
    hours_title: 'Geöffnet Mo-Fr 8-18 Uhr',
    hours_note: 'Nach Absprache können die Räume auch außerhalb der regulären Öffnungszeiten genutzt werden.',
    about: 'Über uns',
    faq: 'FAQ',
    agb: 'AGB',
    sitemap: 'Sitemap',
  },
  en: {
    location_name: 'juggleHUB Coworking & The Daily Café',
    address: 'Immanuelkirchstr. 14a, 10405 Berlin',
    tram: 'Tram stop Hufelandstraße',
    hours_title: 'Open Mon-Fri 8am-6pm',
    hours_note: 'Rooms can also be used outside regular opening hours by arrangement.',
    about: 'About Us',
    faq: 'FAQ',
    agb: 'Terms & Conditions',
    sitemap: 'Sitemap',
  },
}[lang];
---

<footer class="px-4 mt-0">
  <div class="rounded-t-3xl text-white" style="background-color: #013538;">
    <!-- Main info row -->
    <div class="max-w-7xl mx-auto px-8 navbreak:px-14 lg:px-20 py-12 grid grid-cols-1 navbreak:grid-cols-[1fr_2fr_2fr] gap-10 items-start">
      <a href={`${base}/`} class="shrink-0">
        <img src="/logo.svg" alt="JuggleHUB" class="h-7 w-auto" style="filter: brightness(0) invert(1);" />
      </a>
      <div>
        <p class="font-bold text-lg mb-2">{t.location_name}</p>
        <p class="text-white/70 text-sm">{t.address}</p>
        <p class="text-white/70 text-sm">{t.tram}</p>
      </div>
      <div>
        <p class="font-bold text-lg mb-2">{t.hours_title}</p>
        <p class="text-white/70 text-sm leading-relaxed">{t.hours_note}</p>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t mx-8 navbreak:mx-14 lg:mx-20" style="border-color: rgba(255,255,255,0.15);"></div>

    <!-- Bottom bar -->
    <div class="max-w-7xl mx-auto px-8 navbreak:px-14 lg:px-20 py-6 flex flex-col navbreak:flex-row items-center justify-between gap-4">
      <p class="text-white/60 text-sm">© juggleHUB {year}</p>
      <nav class="flex flex-wrap justify-center items-center gap-2 text-sm text-white/60">
        <a href={`${base}/about/`} class="hover:text-white transition-colors py-2 px-2">{t.about}</a>
        <a href={`${base}/about/faq/`} class="hover:text-white transition-colors py-2 px-2">{t.faq}</a>
        <a href={`${base}/agb/`} class="hover:text-white transition-colors py-2 px-2">{t.agb}</a>
        <a href={`${base}/sitemap/`} class="hover:text-white transition-colors py-2 px-2">{t.sitemap}</a>
      </nav>
    </div>
  </div>
</footer>
