---
export interface CarouselItem {
  image: string;
  title: string;
  description: string;
}

export interface Props {
  items: CarouselItem[];
}

const { items } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);
---

<section class="pb-20">
  <div class="max-w-4xl mx-auto px-8 sm:px-14 lg:px-20">
    <div class="relative">
      <!-- Slides -->
      <div class="overflow-hidden rounded-2xl">
        <div id={`carousel-inner-${id}`} class="flex transition-transform duration-400 ease-in-out">
          {items.map((item) => (
            <div class="min-w-full">
              <img src={item.image} alt={item.title} class="w-full aspect-[16/9] object-cover rounded-t-2xl" />
              <div class="bg-white px-8 py-6 rounded-b-2xl border border-t-0 border-gray-100 shadow-lg">
                <h3 class="text-2xl font-black mb-2">{item.title}</h3>
                <p class="text-gray-600 leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Prev / Next buttons -->
      <button id={`carousel-prev-${id}`} aria-label="Previous" class="absolute left-0 top-[45%] -translate-x-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white shadow-lg border border-gray-200 flex items-center justify-center hover:bg-gray-50 transition-colors z-10">
        <svg class="w-5 h-5 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button id={`carousel-next-${id}`} aria-label="Next" class="absolute right-0 top-[45%] translate-x-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white shadow-lg border border-gray-200 flex items-center justify-center hover:bg-gray-50 transition-colors z-10">
        <svg class="w-5 h-5 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Dot indicators -->
    <div class="flex justify-center gap-2 mt-5">
      {items.map((_, i) => (
        <button data-carousel={id} data-dot={i} class={`w-2.5 h-2.5 rounded-full transition-colors ${i === 0 ? 'bg-brand-dark' : 'bg-gray-300'}`} aria-label={`Go to slide ${i + 1}`} />
      ))}
    </div>
  </div>
</section>

<script define:vars={{ id }}>
  const inner = document.getElementById(`carousel-inner-${id}`);
  const dots = document.querySelectorAll(`[data-carousel="${id}"]`);
  const total = inner?.children.length ?? 0;
  let current = 0;

  function goTo(index) {
    current = (index + total) % total;
    inner.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => {
      d.classList.toggle('bg-brand-dark', i === current);
      d.classList.toggle('bg-gray-300', i !== current);
    });
  }

  document.getElementById(`carousel-prev-${id}`)?.addEventListener('click', () => goTo(current - 1));
  document.getElementById(`carousel-next-${id}`)?.addEventListener('click', () => goTo(current + 1));
  dots.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.dot))));

  // Touch swipe
  let touchStartX = 0;
  let touchDeltaX = 0;
  inner?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  inner?.addEventListener('touchmove', (e) => { touchDeltaX = e.touches[0].clientX - touchStartX; }, { passive: true });
  inner?.addEventListener('touchend', () => {
    if (Math.abs(touchDeltaX) > 40) goTo(touchDeltaX < 0 ? current + 1 : current - 1);
    touchDeltaX = 0;
  });
</script>
