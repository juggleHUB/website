---
interface Testimonial {
  text: string;
  name: string;
}

interface Props {
  title: string;
  description: string;
  testimonials: [Testimonial, Testimonial, Testimonial];
}

const { title, description, testimonials } = Astro.props;
---

<section class="bg-brand-cream py-20">
  <div class="max-w-7xl mx-auto px-8 sm:px-14 lg:px-20">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-black mb-3">{title}</h2>
      <p class="text-gray-500 text-lg">{description}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-10">
      {testimonials.map((t) => (
        <div class="flex flex-col items-center text-center">
          <p class="text-gray-700 text-base leading-relaxed mb-4">"{t.text}"</p>
          <div class="flex gap-1 mb-2">
            {[...Array(5)].map(() => (
              <svg class="w-6 h-6 text-brand-teal" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
              </svg>
            ))}
          </div>
          <p class="text-sm text-gray-400">{t.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
