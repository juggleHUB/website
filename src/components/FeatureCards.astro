---
interface Card {
  title: string;
  text?: string;
  items?: string[];
  url?: string;
  image?: string;
}

interface Props {
  cards: Card[];
  desktopCols?: number;
  showIcon?: boolean;
  paddingTop?: string;
}

const { cards, desktopCols = 5, showIcon = true, paddingTop = 'pt-20' } = Astro.props;

// Material Symbols icon per bullet item, keyed by exact item text (DE + EN).
const itemIcons: Record<string, string> = {
  // Arbeiten / Work
  'Flex & Fix Desks': 'desk',
  'Flex & fixed desks': 'desk',
  'Meeting- & Eventräume': 'meeting_room',
  'Meeting & event rooms': 'meeting_room',
  'Drucker': 'print',
  'Printer': 'print',
  'Schnelles WLAN': 'wifi',
  'Fast WiFi': 'wifi',
  // Alltag / Everyday Life
  'Filterkaffee & Tee': 'coffee',
  'Filter coffee & tea': 'coffee',
  'Café im Haus': 'storefront',
  'Café on site': 'storefront',
  'Begrünter Innenhof': 'yard',
  'Green courtyard': 'yard',
  'Community Events': 'celebration',
  // Kinderbetreuung / Childcare
  'Flexibel buchbar': 'event_available',
  'Flexibly bookable': 'event_available',
  'Kurzfristig verfügbar': 'bolt',
  'Available at short notice': 'bolt',
  'Liebevoll begleitet': 'favorite',
  'Caring support': 'favorite',
  'Direkt im Haus': 'home',
  'Right on site': 'home',
  // Membership
  '24/7 Zugang möglich': 'schedule',
  '24/7 access available': 'schedule',
  'Flexible Tarife': 'payments',
  'Flexible plans': 'payments',
  'Private Offices': 'door_front',
  'Private offices': 'door_front',
  'Halbtages- & Tagespässe': 'confirmation_number',
  'Half-day & day passes': 'confirmation_number',
};
---

<section class={`relative pb-20 ${paddingTop}`}>
  <div class="max-w-7xl mx-auto px-8 sm:px-14 lg:px-20">
    <div class="grid md:grid-cols-2 gap-6 navbreak-grid" style={`--desktop-cols: ${desktopCols}`}>
      {cards.map((card) => {
        const isLink = !!card.url;
        const Tag = isLink ? 'a' : 'div';
        return (
          <Tag
            href={isLink ? card.url : undefined}
            class={`rounded-2xl p-6 flex flex-col ${isLink ? 'transition-all duration-200 hover:shadow-lg hover:-translate-y-1 cursor-pointer' : ''}`}
            style="background-color: #E6F5F3;"
          >
            {card.image ? (
              <div class="w-20 h-20 mb-4 rounded-xl overflow-hidden">
                <img src={card.image} alt="" width="80" height="80" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              </div>
            ) : showIcon ? (
              <div class="w-20 h-20 mb-4 bg-gray-200 rounded-xl flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"/>
                  <circle cx="8.5" cy="8.5" r="1.5" stroke-width="0"/>
                  <path d="M21 15l-5-5L5 21" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            ) : null}
            <h3 class="text-xl font-bold mb-3">{card.title}</h3>
            {card.items ? (
              <ul class="flex flex-col gap-2">
                {card.items.map((item) => (
                  <li class="text-gray-600 text-sm leading-relaxed flex items-start gap-2">
                    {itemIcons[item] ? (
                      <span class="material-symbols-outlined text-brand-teal text-[18px] leading-none mt-0.5">{itemIcons[item]}</span>
                    ) : (
                      <span class="text-brand-teal font-bold mt-0.5">·</span>
                    )}
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-gray-600 text-sm leading-relaxed">{card.text}</p>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  @media (min-width: 1100px) {
    .navbreak-grid {
      grid-template-columns: repeat(var(--desktop-cols), minmax(0, 1fr));
    }
  }
</style>
