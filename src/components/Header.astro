---
export interface Props {
  lang: 'de' | 'en';
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;

const otherLang = lang === 'de' ? 'en' : 'de';

// Build the equivalent path in the other language
const otherLangPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`) || `/${otherLang}/`;

const t = {
  de: {
    coworking: 'Coworking',
    eventSpace: 'Event Space',
    childcare: 'Flexible Kinderbetreuung',
    virtualOffice: 'Virtual Office',
    about: 'Über uns',
    ourStory: 'Unsere Geschichte',
    faq: 'FAQ',
    contact: 'Kontakt',
    press: 'Presse',
    team: 'Team',
    cafe: 'Café',
    memberLogin: 'Login',
  },
  en: {
    coworking: 'Coworking',
    eventSpace: 'Event Space',
    childcare: 'Flexible Childcare',
    virtualOffice: 'Virtual Office',
    about: 'About Us',
    ourStory: 'Our Story',
    faq: 'FAQ',
    contact: 'Contact',
    press: 'Press',
    team: 'Team',
    cafe: 'Café',
    memberLogin: 'Login',
  },
}[lang];

const base = `/${lang}`;
---

<header id="site-header" class="fixed top-4 left-4 right-4 z-50 bg-white/95 backdrop-blur-md rounded-full shadow-lg border border-white/30 transition-[box-shadow,backdrop-filter] duration-200">
  <div class="pl-4 pr-3">
    <div class="flex items-center justify-between h-14">
      <!-- Logo -->
      <a href={`${base}/`} class="shrink-0">
        <img src="/logo.svg" alt="JuggleHUB" class="h-[34px] w-auto" />
      </a>

      <!-- Desktop Nav + actions pushed to the right -->
      <nav class="hidden navbreak:flex items-center gap-6">
        <!-- About dropdown -->
        <div class="relative group">
          <a
            href={`${base}/about/`}
            class="text-brand-dark font-medium hover:text-gray-600 transition-colors flex items-center gap-1"
          >
            {t.about}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute top-full left-0 mt-1 w-52 bg-white rounded-lg shadow-lg border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200">
            <a href={`${base}/about/our-story/`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-yellow/20 rounded-t-lg transition-colors">{t.ourStory}</a>
            <a href={`${base}/about/faq/`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-yellow/20 transition-colors">{t.faq}</a>
            <a href={`${base}/about/contact/`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-yellow/20 transition-colors">{t.contact}</a>
            <a href={`${base}/about/press/`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-yellow/20 transition-colors">{t.press}</a>
            <a href={`${base}/about/team/`} class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-yellow/20 rounded-b-lg transition-colors">{t.team}</a>
          </div>
        </div>

        <a href={`${base}/coworking/`} class="text-brand-dark font-medium hover:text-gray-600 transition-colors">{t.coworking}</a>
        <a href={`${base}/flexible-childcare/`} class="text-brand-dark font-medium hover:text-gray-600 transition-colors">{t.childcare}</a>
        <a href={`${base}/event-space/`} class="text-brand-dark font-medium hover:text-gray-600 transition-colors">{t.eventSpace}</a>
        <a href={`${base}/virtual-office/`} class="text-brand-dark font-medium hover:text-gray-600 transition-colors">{t.virtualOffice}</a>
        <a href={`${base}/about/cafe/`} class="text-brand-dark font-medium hover:text-gray-600 transition-colors">{t.cafe}</a>

        <!-- Language toggle -->
        <a
          href={otherLangPath}
          class="text-sm font-semibold text-brand-dark border border-brand-dark/30 px-5 py-2 rounded-full hover:bg-brand-dark hover:text-brand-cream transition-colors"
        >
          {otherLang.toUpperCase()}
        </a>

        <!-- Member login -->
        <a
          href="#"
          class="inline-flex items-center bg-brand-coral text-white font-semibold text-sm px-5 py-2 rounded-full hover:opacity-90 transition-colors"
        >
          {t.memberLogin}
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="navbreak:hidden p-2 text-brand-dark"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden navbreak:hidden px-5 pb-5 space-y-1">
    <a href={`${base}/about/`} class="block py-2 text-brand-dark font-medium">{t.about}</a>
    <a href={`${base}/about/our-story/`} class="block py-1.5 pl-4 text-gray-500 text-sm">{t.ourStory}</a>
    <a href={`${base}/about/faq/`} class="block py-1.5 pl-4 text-gray-500 text-sm">{t.faq}</a>
    <a href={`${base}/about/contact/`} class="block py-1.5 pl-4 text-gray-500 text-sm">{t.contact}</a>
    <a href={`${base}/about/press/`} class="block py-1.5 pl-4 text-gray-500 text-sm">{t.press}</a>
    <a href={`${base}/about/team/`} class="block py-1.5 pl-4 text-gray-500 text-sm">{t.team}</a>
    <a href={`${base}/coworking/`} class="block py-2 text-brand-dark font-medium">{t.coworking}</a>
    <a href={`${base}/flexible-childcare/`} class="block py-2 text-brand-dark font-medium">{t.childcare}</a>
    <a href={`${base}/event-space/`} class="block py-2 text-brand-dark font-medium">{t.eventSpace}</a>
    <a href={`${base}/virtual-office/`} class="block py-2 text-brand-dark font-medium">{t.virtualOffice}</a>
    <a href={`${base}/about/cafe/`} class="block py-2 text-brand-dark font-medium">{t.cafe}</a>
    <div class="pt-3 flex flex-col gap-3">
      <a href="#" class="block w-full text-center bg-brand-coral text-white font-semibold py-2.5 rounded-full">{t.memberLogin}</a>
      <a href={otherLangPath} class="block w-full text-center border border-brand-dark/30 text-brand-dark font-semibold py-2.5 rounded-full text-sm">
        {otherLang.toUpperCase()}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (!isOpen) {
      header?.classList.remove('rounded-full');
      header?.classList.add('rounded-[28px]');
      menu?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      header?.classList.remove('rounded-[28px]');
      header?.classList.add('rounded-full');
      menu?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
